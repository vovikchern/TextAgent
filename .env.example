# ============================================
# ProxyAPI (https://proxyapi.ru) — один ключ для всех моделей
# Скопируйте этот файл в .env и подставьте свой ключ из личного кабинета:
# https://console.proxyapi.ru/keys
# ============================================

# Ключ API ProxyAPI (начинается с "sk-"), используется для обоих режимов
PROXYAPI_KEY=sk-ваш_ключ_здесь

# Обычная модель (OpenAI-совместимый Chat Completions, /v1/chat/completions)
REGULAR_MODEL=openai/gpt-5-mini

# Думающая модель (Anthropic Messages, /v1/messages) — режим по умолчанию
THINKING_MODEL=anthropic/claude-sonnet-4-5

# Бюджет токенов на размышления (reasoning) для думающей модели
THINKING_BUDGET_TOKENS=1500
